{
  "name": "usad",
  "version": "0.1.0",
  "description": "USAD: A Web-Based Student Task Management and Progress Tracking System",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "start:lan": "ng serve --host 0.0.0.0",
    "api": "node data/server.cjs",
    "api:dev": "node --watch data/server.cjs",
    "db:reset": "node data/seed.mjs --reset",
    "test:api": "node --test data/garden.test.cjs data/guest-api.test.cjs"
  },
  "dependencies": {
    "@angular/cdk": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "20.3.34",
    "@ngrx/signals": "^20.0.0",
    "body-parser": "1.20.9",
    "fractional-indexing": "3.2.0",
    "json-server": "0.17.4",
    "rxjs": "~7.8.0",
    "three": "0.180.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/jasmine": "~5.1.0",
    "@types/three": "0.180.0",
    "daisyui": "5.8.2",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.2"
  },
  "license": "MIT"
}
